<Project>
  <PropertyGroup>
    <!-- Enable central package management, https://learn.microsoft.com/en-us/nuget/consume-packages/Central-Package-Management -->
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <!-- Cho phép một dòng PackageVersion nâng cả dependency BẮC CẦU. Thiếu nó thì
         PackageVersion chỉ có tác dụng với package được tham chiếu trực tiếp, và một
         lỗ hổng nằm sâu trong đồ thị (SSH.NET qua Testcontainers, Newtonsoft.Json qua
         Hangfire) không vá được nếu không khai một PackageReference giả ở project
         chẳng dùng tới nó. -->
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup Label="Data">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.11" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <PackageVersion Include="EFCore.NamingConventions" Version="10.0.1" />
  </ItemGroup>
  <ItemGroup Label="Web">
    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Stores" Version="10.0.11" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.11" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.19" />
    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.9.0" />
  </ItemGroup>
  <ItemGroup Label="Cqrs">
    <!-- 12.5.0 là bản MediatR cuối cùng còn Apache-2.0 — ĐỪNG nâng lên 13.x/14.x.
         Từ v13 giấy phép đổi sang RPL-1.5, buộc công khai mã nguồn phần mềm đã triển khai —
         không chấp nhận được với hệ thống chứa điểm và bài nộp của sinh viên. -->
    <PackageVersion Include="MediatR" Version="12.5.0" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>
  <ItemGroup Label="Infra">
    <PackageVersion Include="Hangfire.AspNetCore" Version="1.8.24" />
    <PackageVersion Include="Hangfire.PostgreSql" Version="1.21.1" />
    <!-- Không dùng trực tiếp: nâng Newtonsoft.Json mà Hangfire kéo theo, xem Task 0.9. -->
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageVersion Include="AWSSDK.S3" Version="4.0.102.1" />
    <PackageVersion Include="ClosedXML" Version="0.105.1" />
    <PackageVersion Include="SixLabors.ImageSharp" Version="4.1.0" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="AspNetCore.HealthChecks.NpgSql" Version="9.0.0" />
  </ItemGroup>
  <ItemGroup Label="Test">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
    <PackageVersion Include="NSubstitute" Version="6.2.0" />
    <!-- Không dùng trực tiếp: Testcontainers kéo theo SSH.NET 2025.1.0 dính lỗ hổng high
         (GHSA-q939-rpr3-3284). NuGet audit báo NU1903, và TreatWarningsAsErrors biến nó
         thành lỗi build. Khai trực tiếp bản đã vá để nâng phiên bản được giải quyết —
         cùng cách xử lý với Newtonsoft.Json ở Task 0.9. ĐỪNG tắt NuGetAudit để né. -->
    <PackageVersion Include="SSH.NET" Version="2026.0.0" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Minio" Version="4.13.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.11" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.10.0" />
  </ItemGroup>
</Project>